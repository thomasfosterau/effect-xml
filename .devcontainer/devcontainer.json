{
  "name": "effect-xml",
  // Keep the tag at the catalog's `vite-plus` pin.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.5.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "postCreateCommand": "vp install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode"]
    }
  },
  "workspaceFolder": "/workspaces/effect-xml"
}
