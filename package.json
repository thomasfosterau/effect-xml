{
  "name": "effect-sax",
  "version": "0.2.0",
  "description": "Type-safe, streaming XML & HTML parsing for the Effect ecosystem: an incremental SAX interface plus xml5ever/html5ever-style parsers.",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./Sax": "./src/Sax.ts",
    "./Xml": "./src/Xml/index.ts",
    "./Html": "./src/Html/index.ts"
  },
  "scripts": {
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "example": "bun run examples/usage.ts"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-parse": "^0.1.0",
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "@thomasfosterau/effect-parse": "^0.1.0",
    "@types/bun": "^1.3.14",
    "effect": "^4.0.5",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "xml",
    "html",
    "parser",
    "sax",
    "streaming",
    "effect",
    "schema",
    "type-safe",
    "html5ever",
    "xml5ever",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-sax.git"
  },
  "license": "MIT"
}
