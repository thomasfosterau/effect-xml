{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-xml",
  "version": "0.2.0",
  "description": "Type-safe, streaming XML & HTML parsing for the Effect ecosystem: an incremental SAX interface plus xml5ever/html5ever-style parsers.",
  "keywords": [
    "effect",
    "html",
    "html5ever",
    "parser",
    "sax",
    "schema",
    "streaming",
    "type-safe",
    "xml",
    "xml-schema",
    "xml5ever",
    "xsd"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-xml#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-xml.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Sax": {
      "types": "./dist/Sax.d.ts",
      "default": "./dist/Sax.js"
    },
    "./Xml": {
      "types": "./dist/Xml.d.ts",
      "default": "./dist/Xml.js"
    },
    "./Html": {
      "types": "./dist/Html.d.ts",
      "default": "./dist/Html.js"
    },
    "./Xsd": {
      "types": "./dist/Xsd.d.ts",
      "default": "./dist/Xsd.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "bash scripts/release.sh",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@thomasfosterau/effect-parse": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-parse": "catalog:peers",
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0"
}
