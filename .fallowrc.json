{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.ts",
    "src/Sax.ts",
    "src/Xml/index.ts",
    "src/Html/index.ts",
    "src/Xsd/index.ts",
    "tests/**/*.test.ts",
    "examples/usage.ts",
    "packages/cli/src/main.ts",
    "packages/cli/tests/**/*.test.ts",
    "packages/cli/vite.config.ts",
    "bench/parse.ts",
    "vite.config.ts"
  ],
  "ignoreExports": [{ "file": "src/Xsd/Validate.ts", "exports": ["select"] }],
  "ignorePatterns": ["**/dist/**", "**/docs/**", "**/coverage/**", "tests/fixtures/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/docgen",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "tsx",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "fallow",
    "@thomasfosterau/effect-parse",
    "@thomasfosterau/effect-xml"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "internal",
        "patterns": ["src/internal/**"]
      },
      {
        "name": "public",
        "patterns": [
          "src/{Encoding,Error,Limits,Name,Position,Sax,index}.ts",
          "src/Xml/**",
          "src/Html/**",
          "src/Xsd/**"
        ]
      },
      {
        "name": "tests",
        "patterns": ["tests/**", "examples/**"]
      }
    ],
    "rules": [
      {
        "from": "internal",
        "allow": ["public"]
      },
      {
        "from": "public",
        "allow": ["internal"]
      },
      {
        "from": "tests",
        "allow": ["public"]
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
